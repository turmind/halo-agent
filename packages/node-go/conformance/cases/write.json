[
 {
  "group": "write",
  "config": {
   "mode": "folder",
   "shell": false
  },
  "tree": "probe",
  "cases": [
   {
    "name": "write new nested",
    "calls": [
     {
      "op": "write",
      "args": {
       "path": "new/deep/n.txt",
       "content": "hi"
      }
     }
    ],
    "tags": [
     "smoke"
    ],
    "after": [
     "root/new/deep/n.txt"
    ]
   },
   {
    "name": "write abs inside",
    "calls": [
     {
      "op": "write",
      "args": {
       "path": "<ROOT>/abs.txt",
       "content": "x"
      }
     }
    ],
    "after": [
     "root/abs.txt"
    ]
   },
   {
    "name": "write via link-to-sub",
    "calls": [
     {
      "op": "write",
      "args": {
       "path": "link-to-sub/w.txt",
       "content": "x"
      }
     }
    ],
    "after": [
     "root/sub/w.txt"
    ]
   },
   {
    "name": "write missing content",
    "calls": [
     {
      "op": "write",
      "args": {
       "path": "mc.txt"
      }
     }
    ],
    "after": [
     "root/mc.txt"
    ]
   },
   {
    "name": "write content number",
    "calls": [
     {
      "op": "write",
      "args": {
       "path": "num.txt",
       "content": 5
      }
     }
    ],
    "after": [
     "root/num.txt"
    ]
   },
   {
    "name": "write onto dir",
    "calls": [
     {
      "op": "write",
      "args": {
       "path": "sub",
       "content": "x"
      }
     }
    ]
   },
   {
    "name": "write parent is file",
    "calls": [
     {
      "op": "write",
      "args": {
       "path": "a.txt/x.txt",
       "content": "x"
      }
     }
    ],
    "tags": [
     "smoke"
    ]
   },
   {
    "name": "write astral + lone surrogate",
    "calls": [
     {
      "op": "write",
      "args": {
       "path": "astral.txt",
       "content": "a😀b\ud83dc"
      }
     }
