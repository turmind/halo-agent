[
 {
  "group": "run",
  "config": {
   "mode": "folder",
   "shell": true,
   "env": {
    "HALO_PASSWORD": "p",
    "HALO_JWT_SECRET": "j",
    "KEEP_ME": "k"
   }
  },
  "tree": "probe",
  "cases": [
   {
    "name": "run echo",
    "calls": [
     {
      "op": "run",
      "args": {
       "command": "echo hi"
      }
     }
    ],
    "tags": [
     "smoke"
    ]
   },
   {
    "name": "run stderr ok",
    "calls": [
     {
      "op": "run",
      "args": {
       "command": "echo out; echo err >&2"
      }
     }
    ]
   },
   {
    "name": "run fail",
    "calls": [
     {
      "op": "run",
      "args": {
       "command": "echo o; echo e >&2; exit 3"
      }
     }
    ],
    "tags": [
     "smoke"
    ]
   },
   {
    "name": "run no output",
    "calls": [
     {
      "op": "run",
      "args": {
       "command": "true"
      }
     }
    ]
   },
   {
    "name": "run trim ws",
    "calls": [
     {
      "op": "run",
      "args": {
       "command": "  ﻿echo  x  \n"
      }
     }
    ]
   },
   {
    "name": "run env stripped",
    "calls": [
     {
      "op": "run",
      "args": {
       "command": "echo \"[${HALO_NODE_TOKEN-unset}][${HALO_PASSWORD-unset}][${HALO_JWT_SECRET-unset}][${KEEP_ME-unset}]\""
      }
     }
    ]
   },
   {
    "name": "run cwd sub",
    "calls": [
     {
      "op": "run",
      "args": {
       "command": "pwd",
       "cwd": "sub"
      }
     }
    ],
    "tags": [
     "smoke"
    ]
   },
   {
    "name": "run cwd missing",
    "calls": [
     {
      "op": "run",
      "args": {
       "command": "pwd",
       "cwd": "nope"
      }
     }
    ]
   },
   {
    "name": "run cwd outside",
    "calls": [
     {
      "op": "run",
      "args": {
       "command": "pwd",
       "cwd": ".."
      }
     }
    ]
   },
   {
    "name": "run cwd via link-to-sub",
    "calls": [
     {
      "op": "run",
      "args": {
       "command": "pwd",
       "cwd": "link-to-sub"
      }
     }
    ]
   },
   {
    "name": "run empty",
    "calls": [
     {
      "op": "run",
      "args": {
       "command": "   "
      }
     }
    ]
   },
   {
    "name": "run no command",
    "calls": [
     {
      "op": "run",
      "args": {}
     }
    ]
   },
   {
    "name": "run params literal",
    "calls": [
     {
      "op": "run",
      "args": {
       "command": "echo \"{{foo.params.bar}}\""
      }
     }
    ]
   },
   {
    "name": "run utf8 + invalid",
    "calls": [
     {
      "op": "run",
      "args": {
       "command": "printf 'caf\\303\\251 \\377 done'"
      }
     }
    ]
   },
   {
    "name": "run killed by signal",
    "calls": [
     {
      "op": "run",
      "args": {
       "command": "echo pre; kill -9 $$"
      }
     }
    ]
   },
   {
    "name": "run rm guard",
    "calls": [
     {
      "op": "run",
      "args": {
       "command": "rm -rf ~"
      }
     }
    ],
    "tags": [
     "smoke"
    ]
   },
   {
    "name": "run large output",
    "calls": [
     {
      "op": "run",
      "args": {
       "command": "head -c 300000 /dev/zero | tr \"\\0\" x"
      }
     }
    ]
   },
   {
    "name": "unknown op",
    "calls": [
     {
      "op": "bogus",
      "args": {}
     }
    ]
   }
  ]
 }
]
