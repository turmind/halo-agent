[
 {
  "group": "grep",
  "config": {
   "mode": "folder",
   "shell": false
  },
  "tree": "probe",
  "cases": [
   {
    "name": "grep basic",
    "calls": [
     {
      "op": "grep",
      "args": {
       "pattern": "export"
      }
     }
    ],
    "tags": [
     "smoke"
    ]
   },
   {
    "name": "grep include brace",
    "calls": [
     {
      "op": "grep",
      "args": {
       "pattern": ".",
       "include": "*.{ts,tsx}"
      }
     }
    ],
    "tags": [
     "smoke"
    ]
   },
   {
    "name": "grep include list",
    "calls": [
     {
      "op": "grep",
      "args": {
       "pattern": "e",
       "include": "*.txt, *.tsx"
      }
     }
    ]
   },
   {
    "name": "grep file target",
    "calls": [
     {
      "op": "grep",
      "args": {
       "pattern": "b",
       "path": "a.txt"
      }
     }
    ]
   },
